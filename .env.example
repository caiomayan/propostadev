DATABASE_URL=postgresql://proposta:local_proposta_password@localhost:5434/propostadev
DATABASE_URL_TEST=postgresql://proposta:local_proposta_password@localhost:5434/propostadev_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
POSTGRES_DB=propostadev
POSTGRES_USER=proposta
POSTGRES_PASSWORD=local_proposta_password
POSTGRES_PORT=5434

# --- Login social (opcional). Cada provedor só é ativado com ID e segredo; sem eles, o botão não aparece.
# Callback GitHub:  http://localhost:3000/api/auth/callback/github  (produção: https://propostadev-one.vercel.app/api/auth/callback/github)
# Callback Google:  http://localhost:3000/api/auth/callback/google  (produção: https://propostadev-one.vercel.app/api/auth/callback/google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail transacional por SMTP (opcional): recuperação de senha e verificação de e-mail.
# Sem SMTP_USER/SMTP_PASS: em desenvolvimento o link é impresso no console; em produção a recuperação não é oferecida.
# No Gmail, use uma senha de app (conta com verificação em duas etapas), nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente; se vazio, usa SMTP_USER.
EMAIL_FROM=

# --- Preço de mercado externo (MVP 3). Sem FIRECRAWL_API_KEY a coleta não roda; a tela mostra "Ainda não há preço externo".
FIRECRAWL_API_KEY=
# Segredo do Cron da Vercel: a rota /api/cron/precos-externos só aceita "Authorization: Bearer <CRON_SECRET>". Sem ele a rota recusa tudo.
CRON_SECRET=

# --- Equipe da plataforma (painel /plataforma, onde se concede e retira o VIP). Lista de e-mails separados por vírgula, sem caixa; só vale e-mail confirmado.
# Vazia: ninguém acessa e o endereço responde 404. Não é secreta. Em Production: plataforma@demo.example (a demo cria essa conta).
PLATAFORMA_EMAILS=plataforma@demo.example
